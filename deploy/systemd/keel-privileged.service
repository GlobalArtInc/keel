[Unit]
Description=keel privileged code path
Documentation=https://github.com/GlobalArtInc/keel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/keel/bin/current privileged --socket /run/keel/agent.sock --policy /etc/keel/agent.yaml
WorkingDirectory=/opt/keel
Restart=always
RestartSec=2
TimeoutStopSec=30
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
