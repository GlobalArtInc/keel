{
  "name": "keel-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": "24",
    "pnpm": "11"
  },
  "scripts": {
    "generate": "node tools/generate.mjs && node tools/icons.mjs && node tools/boot.mjs",
    "lint": "eslint . && tsc -p e2e/tsconfig.json",
    "test": "node --no-sparkplug node_modules/jest/bin/jest.js",
    "build": "ng build keel && ng build demo && ng build dns && ng build shell && node tools/theme-boot.mjs dist/shell && node tools/compress.mjs dist/shell",
    "format": "prettier --check .",
    "storybook": "ng run keel:storybook",
    "build-storybook": "ng run keel:build-storybook",
    "test-storybook": "test-storybook --url http://127.0.0.1:6006 --ci",
    "e2e": "playwright test -c e2e/playwright.config.ts"
  },
  "dependencies": {
    "@angular/animations": "~19.1.8",
    "@angular/cdk": "~19.1.5",
    "@angular/common": "~19.1.8",
    "@angular/compiler": "~19.1.8",
    "@angular/core": "~19.1.8",
    "@angular/forms": "~19.1.8",
    "@angular/platform-browser": "~19.1.8",
    "@angular/platform-browser-dynamic": "~19.1.8",
    "@angular/router": "~19.1.8",
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@globalart/phoenix-ui": "0.3.5",
    "lucide-angular": "^1.0.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~19.1.9",
    "@angular/cli": "~19.1.9",
    "@angular/compiler-cli": "~19.1.8",
    "@eslint/js": "^9.26.0",
    "@playwright/test": "^1.62.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/angular": "^10.6.0",
    "@storybook/test-runner": "^0.24.0",
    "@types/jest": "^29.5.14",
    "@types/node": "26.5.1",
    "@types/qrcode": "^1.5.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "angular-eslint": "^19.4.0",
    "axe-playwright": "^2.2.0",
    "eslint": "^9.26.0",
    "http-server": "^14.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-preset-angular": "~14.4.2",
    "json-schema-to-typescript": "16.0.0",
    "ng-packagr": "^19.2.2",
    "otpauth": "^9.5.2",
    "playwright": "^1.62.0",
    "prettier": "^3.5.0",
    "storybook": "^10.6.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.32.1",
    "wait-on": "^8.0.0"
  }
}
