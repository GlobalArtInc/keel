{
  "keel": 1,
  "name": "note.list",
  "module": "note",
  "kind": "list",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "note.read"
  },
  "key": "id",
  "params": {
    "$ref": "keel://ListQuery"
  },
  "result": {
    "title": "Page_Note",
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Note"
        }
      },
      "total": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "totals": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "data",
      "total"
    ],
    "$defs": {
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "due": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "accountId",
          "title",
          "body",
          "kind",
          "tags",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  },
  "ui": {
    "title": "note.list.title",
    "search": [
      "title"
    ],
    "columns": [
      {
        "key": "title",
        "type": "link",
        "to": {
          "screen": "note.edit",
          "params": {
            "id": "$id"
          }
        },
        "sortable": true,
        "primary": true
      },
      {
        "key": "kind",
        "type": "status",
        "map": {
          "memo": "neutral",
          "todo": "warning"
        },
        "filter": {
          "options": [
            "memo",
            "todo"
          ]
        }
      },
      {
        "key": "tags",
        "type": "text"
      },
      {
        "key": "due",
        "type": "date",
        "sortable": true
      },
      {
        "key": "updatedAt",
        "type": "datetime",
        "sortable": true
      },
      {
        "key": "accountId",
        "type": "text",
        "filter": {
          "remote": "keel.account.options"
        },
        "access": {
          "level": "reseller"
        }
      }
    ],
    "actions": [
      {
        "id": "create",
        "role": "new",
        "screen": "note.edit",
        "icon": "plus"
      },
      {
        "id": "edit",
        "role": "edit",
        "screen": "note.edit",
        "default": true
      },
      {
        "id": "delete",
        "role": "delete",
        "function": "note.delete",
        "confirm": {
          "destructive": true,
          "items": "title",
          "input": "count"
        }
      }
    ],
    "row_actions": [
      "edit",
      "delete"
    ],
    "empty": {
      "title": "note.empty",
      "action": "create"
    },
    "invalidate_on": [
      "note.*"
    ]
  }
}
