{
  "keel": 1,
  "name": "backup.restore",
  "module": "backup",
  "kind": "form",
  "mode": "write",
  "access": {
    "level": "admin"
  },
  "params": {
    "title": "Pick",
    "type": "object",
    "properties": {
      "archive": {
        "type": "string",
        "minLength": 1,
        "maxLength": 255,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.tar\\.zst$"
      }
    },
    "required": [
      "archive"
    ]
  },
  "result": {
    "title": "Requested",
    "type": "object",
    "properties": {
      "archive": {
        "type": "string"
      },
      "keel": {
        "type": "string"
      },
      "products": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "tables": {
        "type": "integer",
        "format": "uint32",
        "minimum": 0
      },
      "secretKey": {
        "type": "boolean"
      },
      "request": {
        "type": "string"
      },
      "requestedBy": {
        "type": "string"
      }
    },
    "required": [
      "archive",
      "keel",
      "products",
      "tables",
      "secretKey",
      "request",
      "requestedBy"
    ]
  },
  "ui": {
    "title": "backup.restore.title",
    "pages": [
      {
        "id": "main",
        "fields": [
          "archive"
        ]
      }
    ],
    "result": "task"
  }
}
