{
  "keel": 1,
  "name": "plugin.list",
  "module": "plugin",
  "kind": "list",
  "mode": "read",
  "access": {
    "level": "admin"
  },
  "key": "id",
  "params": {
    "$ref": "keel://ListQuery"
  },
  "result": {
    "title": "Page_PluginRow",
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/PluginRow"
        }
      },
      "total": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "totals": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "data",
      "total"
    ],
    "$defs": {
      "PluginRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "level": {
            "anyOf": [
              {
                "$ref": "#/$defs/Level"
              },
              {
                "type": "null"
              }
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/$defs/Status"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "enabled",
          "status"
        ]
      },
      "Level": {
        "type": "string",
        "enum": [
          "guest",
          "service",
          "user",
          "reseller",
          "admin",
          "owner"
        ]
      },
      "Status": {
        "type": "string",
        "enum": [
          "loaded",
          "refused",
          "unloaded"
        ]
      }
    }
  },
  "ui": {
    "title": "plugin.list.title",
    "columns": [
      {
        "key": "id",
        "type": "text",
        "primary": true
      },
      {
        "key": "version",
        "type": "text"
      },
      {
        "key": "level",
        "type": "text"
      },
      {
        "key": "enabled",
        "type": "boolean"
      },
      {
        "key": "status",
        "type": "status",
        "map": {
          "loaded": "success",
          "refused": "danger",
          "unloaded": "neutral"
        }
      },
      {
        "key": "reason",
        "type": "text"
      }
    ],
    "actions": [
      {
        "id": "enable",
        "role": "button",
        "function": "plugin.enable",
        "params": {
          "id": "$id"
        },
        "confirm": true
      },
      {
        "id": "disable",
        "role": "button",
        "function": "plugin.disable",
        "params": {
          "id": "$id"
        },
        "confirm": true
      }
    ],
    "row_actions": [
      "enable",
      "disable"
    ],
    "empty": {
      "title": "plugin.empty"
    }
  }
}
