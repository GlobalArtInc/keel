{
  "keel": 1,
  "name": "svc.dns.zones.login",
  "module": "svc",
  "kind": "action",
  "mode": "write",
  "access": {
    "level": "admin"
  },
  "params": {
    "title": "ServiceRef",
    "type": "object",
    "properties": {
      "externalId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[!#-+\\--:<-\\[\\]-~]+$"
      }
    },
    "required": [
      "externalId"
    ]
  },
  "result": {
    "title": "LoginTarget",
    "type": "object",
    "properties": {
      "url": {
        "type": "string"
      }
    },
    "required": [
      "url"
    ]
  }
}
