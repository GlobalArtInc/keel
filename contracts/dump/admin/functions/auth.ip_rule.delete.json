{
  "keel": 1,
  "name": "auth.ip_rule.delete",
  "module": "auth",
  "kind": "action",
  "mode": "write",
  "access": {
    "level": "admin"
  },
  "params": {
    "title": "Pick",
    "type": "object",
    "properties": {
      "id": {
        "$ref": "#/$defs/Id"
      }
    },
    "required": [
      "id"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "result": {
    "title": "IpRuleDeleted",
    "type": "object",
    "properties": {
      "deleted": {
        "type": "boolean"
      }
    },
    "required": [
      "deleted"
    ]
  }
}
