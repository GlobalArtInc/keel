{
  "keel": 1,
  "name": "plugin.get",
  "module": "plugin",
  "kind": "get",
  "mode": "read",
  "access": {
    "level": "admin"
  },
  "key": "id",
  "params": {
    "title": "PluginPick",
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "required": [
      "id"
    ]
  },
  "result": {
    "title": "PluginDetail",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "version": {
        "type": [
          "string",
          "null"
        ]
      },
      "level": {
        "anyOf": [
          {
            "$ref": "#/$defs/Level"
          },
          {
            "type": "null"
          }
        ]
      },
      "enabled": {
        "type": "boolean"
      },
      "status": {
        "$ref": "#/$defs/Status"
      },
      "reason": {
        "type": [
          "string",
          "null"
        ]
      },
      "mode": {
        "type": [
          "string",
          "null"
        ]
      },
      "storage": {
        "type": "boolean"
      },
      "functions": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "observe": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "hook": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "patch": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "id",
      "enabled",
      "status",
      "storage",
      "functions",
      "observe",
      "hook",
      "patch"
    ],
    "$defs": {
      "Level": {
        "type": "string",
        "enum": [
          "guest",
          "service",
          "user",
          "reseller",
          "admin",
          "owner"
        ]
      },
      "Status": {
        "type": "string",
        "enum": [
          "loaded",
          "refused",
          "unloaded"
        ]
      }
    }
  }
}
