{
  "keel": 1,
  "name": "auth.password.reset.confirm",
  "module": "auth",
  "kind": "form",
  "mode": "write",
  "access": {
    "level": "guest"
  },
  "params": {
    "title": "ResetConfirm",
    "type": "object",
    "properties": {
      "token": {
        "$ref": "#/$defs/Secret",
        "x-keel": {
          "secret": true
        }
      },
      "password": {
        "$ref": "#/$defs/Secret",
        "x-keel": {
          "secret": true
        },
        "x-ui": {
          "control": "password"
        }
      }
    },
    "required": [
      "token",
      "password"
    ],
    "$defs": {
      "Secret": {
        "type": "string",
        "writeOnly": true
      }
    }
  },
  "result": {
    "title": "ResetDone",
    "type": "object",
    "properties": {
      "login": {
        "type": "string"
      }
    },
    "required": [
      "login"
    ]
  },
  "ui": {
    "title": "auth.password.reset.confirm.title",
    "pages": [
      {
        "id": "main",
        "fields": [
          "token",
          "password"
        ]
      }
    ]
  }
}
