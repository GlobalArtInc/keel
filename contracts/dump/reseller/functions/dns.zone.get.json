{
  "keel": 1,
  "name": "dns.zone.get",
  "module": "dns",
  "kind": "get",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "dns.zone.read",
    "feature": "dns.zones"
  },
  "key": "id",
  "params": {
    "title": "Pick",
    "type": "object",
    "properties": {
      "id": {
        "$ref": "#/$defs/Id"
      }
    },
    "required": [
      "id"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "result": {
    "title": "Zone",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "accountId": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "serial": {
        "type": "integer",
        "format": "int64"
      },
      "refresh": {
        "type": "integer",
        "format": "int32"
      },
      "retry": {
        "type": "integer",
        "format": "int32"
      },
      "expire": {
        "type": "integer",
        "format": "int32"
      },
      "minimum": {
        "type": "integer",
        "format": "int32"
      },
      "template": {
        "type": [
          "string",
          "null"
        ]
      },
      "state": {
        "type": "string"
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "served": {
        "type": "boolean"
      },
      "suspended": {
        "type": "boolean"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "accountId",
      "name",
      "kind",
      "serial",
      "refresh",
      "retry",
      "expire",
      "minimum",
      "state",
      "served",
      "suspended",
      "createdAt",
      "updatedAt"
    ]
  }
}
