{
  "keel": 1,
  "name": "hosting.database.list",
  "module": "hosting_database",
  "kind": "list",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "hosting.database.read",
    "feature": "panel.databases"
  },
  "key": "id",
  "params": {
    "$ref": "keel://ListQuery"
  },
  "result": {
    "title": "Page_HostingDatabase",
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/HostingDatabase"
        }
      },
      "total": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "totals": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "data",
      "total"
    ],
    "$defs": {
      "HostingDatabase": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "accountId",
          "userId",
          "name",
          "state",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  },
  "ui": {
    "title": "hosting.database.list.title",
    "search": [
      "name"
    ],
    "columns": [
      {
        "key": "name",
        "type": "text",
        "sortable": true,
        "primary": true
      },
      {
        "key": "state",
        "type": "status",
        "map": {
          "active": "success",
          "error": "danger",
          "pending": "neutral"
        },
        "filter": {
          "options": [
            "pending",
            "active",
            "error"
          ]
        }
      },
      {
        "key": "error",
        "type": "text"
      },
      {
        "key": "accountId",
        "type": "text",
        "filter": {
          "remote": "keel.account.options"
        },
        "access": {
          "level": "reseller"
        }
      }
    ],
    "actions": [
      {
        "id": "create",
        "role": "new",
        "screen": "hosting.database.create",
        "icon": "plus"
      },
      {
        "id": "delete",
        "role": "delete",
        "function": "hosting.database.delete",
        "confirm": {
          "destructive": true,
          "items": "name",
          "input": "count"
        }
      }
    ],
    "row_actions": [
      "delete"
    ],
    "empty": {
      "title": "hosting.database.empty",
      "action": "create"
    },
    "invalidate_on": [
      "hosting.database.*"
    ]
  }
}
