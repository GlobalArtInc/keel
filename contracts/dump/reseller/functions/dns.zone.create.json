{
  "keel": 1,
  "name": "dns.zone.create",
  "module": "dns",
  "kind": "form",
  "mode": "write",
  "access": {
    "level": "user",
    "permission": "dns.zone.manage",
    "feature": "dns.zones"
  },
  "key": "id",
  "params": {
    "title": "ZoneCreate",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 3,
        "maxLength": 253,
        "x-keel": {
          "check": "domain"
        }
      },
      "template": {
        "anyOf": [
          {
            "$ref": "#/$defs/Id"
          },
          {
            "type": "null"
          }
        ],
        "x-keel": {
          "options": "dns.template.options"
        },
        "x-ui": {
          "control": "select"
        }
      },
      "ip": {
        "type": [
          "string",
          "null"
        ],
        "x-keel": {
          "check": "ipv4"
        }
      },
      "ip6": {
        "type": [
          "string",
          "null"
        ],
        "x-keel": {
          "check": "ipv6"
        }
      },
      "refresh": {
        "type": "integer",
        "format": "uint32",
        "minimum": 60,
        "maximum": 2419200,
        "default": 10800
      },
      "retry": {
        "type": "integer",
        "format": "uint32",
        "minimum": 60,
        "maximum": 2419200,
        "default": 3600
      },
      "expire": {
        "type": "integer",
        "format": "uint32",
        "minimum": 3600,
        "maximum": 4838400,
        "default": 604800
      },
      "minimum": {
        "type": "integer",
        "format": "uint32",
        "minimum": 60,
        "maximum": 86400,
        "default": 3600
      },
      "account": {
        "anyOf": [
          {
            "$ref": "#/$defs/Id"
          },
          {
            "type": "null"
          }
        ],
        "x-keel": {
          "level": "reseller",
          "options": "keel.account.options"
        }
      }
    },
    "required": [
      "name"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "result": {
    "title": "Zone",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "accountId": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "serial": {
        "type": "integer",
        "format": "int64"
      },
      "refresh": {
        "type": "integer",
        "format": "int32"
      },
      "retry": {
        "type": "integer",
        "format": "int32"
      },
      "expire": {
        "type": "integer",
        "format": "int32"
      },
      "minimum": {
        "type": "integer",
        "format": "int32"
      },
      "template": {
        "type": [
          "string",
          "null"
        ]
      },
      "state": {
        "type": "string"
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "served": {
        "type": "boolean"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "accountId",
      "name",
      "kind",
      "serial",
      "refresh",
      "retry",
      "expire",
      "minimum",
      "state",
      "served",
      "createdAt",
      "updatedAt"
    ]
  },
  "ui": {
    "title": "dns.zone.create.title",
    "pages": [
      {
        "id": "main",
        "fields": [
          "name",
          "template",
          "ip",
          "ip6",
          "refresh",
          "retry",
          "expire",
          "minimum"
        ]
      },
      {
        "id": "owner",
        "fields": [
          "account"
        ],
        "show_if": {
          "ne": [
            "$principal.level",
            "user"
          ]
        }
      }
    ],
    "fields": {
      "ip": {
        "show_if": {
          "truthy": "template"
        }
      },
      "ip6": {
        "show_if": {
          "truthy": "template"
        }
      }
    }
  }
}
