{
  "keel": 1,
  "name": "keel.principal.update",
  "module": "keel",
  "kind": "form",
  "mode": "write",
  "access": {
    "level": "user",
    "permission": "keel.principal.manage"
  },
  "key": "id",
  "params": {
    "title": "PrincipalUpdate",
    "type": "object",
    "properties": {
      "id": {
        "$ref": "#/$defs/Id"
      },
      "login": {
        "type": [
          "string",
          "null"
        ],
        "minLength": 1,
        "maxLength": 64
      },
      "level": {
        "anyOf": [
          {
            "$ref": "#/$defs/Level"
          },
          {
            "type": "null"
          }
        ]
      },
      "role": {
        "type": [
          "string",
          "null"
        ]
      },
      "lang": {
        "type": [
          "string",
          "null"
        ]
      },
      "account": {
        "anyOf": [
          {
            "$ref": "#/$defs/Id"
          },
          {
            "type": "null"
          }
        ],
        "x-keel": {
          "level": "reseller",
          "options": "keel.account.options"
        }
      }
    },
    "required": [
      "id"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      },
      "Level": {
        "type": "string",
        "enum": [
          "guest",
          "service",
          "user",
          "reseller",
          "admin",
          "owner"
        ]
      }
    }
  },
  "result": {
    "title": "Saved",
    "type": "object",
    "properties": {
      "id": {
        "$ref": "#/$defs/Id"
      }
    },
    "required": [
      "id"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "ui": {
    "title": "keel.principal.update.title",
    "read": "keel.principal.get",
    "pages": [
      {
        "id": "main",
        "fields": [
          "login",
          "level",
          "role",
          "lang",
          "account"
        ]
      }
    ]
  }
}
