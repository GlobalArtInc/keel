{
  "keel": 1,
  "name": "hosting.database.user.get",
  "module": "hosting_database",
  "kind": "get",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "hosting.database.read",
    "feature": "panel.databases"
  },
  "key": "id",
  "params": {
    "title": "Pick",
    "type": "object",
    "properties": {
      "id": {
        "$ref": "#/$defs/Id"
      }
    },
    "required": [
      "id"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "result": {
    "title": "DatabaseUserView",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "accountId": {
        "type": "string"
      },
      "userId": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "state": {
        "type": "string"
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      },
      "databases": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Id"
        }
      }
    },
    "required": [
      "id",
      "accountId",
      "userId",
      "name",
      "state",
      "createdAt",
      "updatedAt",
      "databases"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  }
}
