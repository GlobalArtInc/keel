{
  "keel": 1,
  "name": "keel.account.get",
  "module": "keel",
  "kind": "get",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "keel.account.read"
  },
  "key": "id",
  "params": {
    "title": "Pick",
    "type": "object",
    "properties": {
      "id": {
        "$ref": "#/$defs/Id"
      }
    },
    "required": [
      "id"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "result": {
    "title": "Account",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "kind": {
        "type": "string"
      },
      "parentId": {
        "type": [
          "string",
          "null"
        ],
        "x-keel": {
          "level": "reseller"
        }
      },
      "path": {
        "type": "string",
        "x-keel": {
          "level": "reseller"
        }
      },
      "state": {
        "type": "string"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "kind",
      "path",
      "state",
      "createdAt",
      "updatedAt"
    ]
  }
}
