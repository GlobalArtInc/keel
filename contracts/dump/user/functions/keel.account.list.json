{
  "keel": 1,
  "name": "keel.account.list",
  "module": "keel",
  "kind": "list",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "keel.account.read"
  },
  "key": "id",
  "params": {
    "$ref": "keel://ListQuery"
  },
  "result": {
    "title": "Page_AccountRow",
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/AccountRow"
        }
      },
      "total": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "totals": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "data",
      "total"
    ],
    "$defs": {
      "AccountRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "kind",
          "state",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  },
  "ui": {
    "title": "keel.account.list.title",
    "search": [
      "id",
      "kind"
    ],
    "columns": [
      {
        "key": "label",
        "type": "link",
        "to": {
          "screen": "keel.account.update",
          "params": {
            "id": "$id"
          }
        },
        "primary": true
      },
      {
        "key": "kind",
        "type": "status",
        "sortable": true,
        "map": {
          "reseller": "neutral",
          "system": "info",
          "user": "neutral"
        }
      },
      {
        "key": "state",
        "type": "status",
        "map": {
          "active": "success",
          "deleting": "danger",
          "suspended": "warning"
        },
        "filter": {
          "options": [
            "active",
            "suspended",
            "deleting"
          ]
        }
      },
      {
        "key": "id",
        "type": "text",
        "sortable": true
      },
      {
        "key": "createdAt",
        "type": "datetime",
        "sortable": true
      }
    ],
    "empty": {
      "title": "keel.account.empty"
    },
    "invalidate_on": [
      "keel.account.*",
      "keel.principal.*"
    ]
  }
}
