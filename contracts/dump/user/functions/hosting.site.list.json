{
  "keel": 1,
  "name": "hosting.site.list",
  "module": "hosting_site",
  "kind": "list",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "hosting.site.read",
    "feature": "panel.web"
  },
  "key": "id",
  "params": {
    "$ref": "keel://ListQuery"
  },
  "result": {
    "title": "Page_HostingSite",
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/HostingSite"
        }
      },
      "total": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "totals": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "data",
      "total"
    ],
    "$defs": {
      "HostingSite": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "userId": {
            "type": "string"
          },
          "domain": {
            "type": "string"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "root": {
            "type": "string"
          },
          "php": {
            "type": [
              "string",
              "null"
            ]
          },
          "suspended": {
            "type": "boolean"
          },
          "state": {
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "zoneError": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "accountId",
          "userId",
          "domain",
          "aliases",
          "root",
          "suspended",
          "state",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  },
  "ui": {
    "title": "hosting.site.list.title",
    "search": [
      "domain"
    ],
    "columns": [
      {
        "key": "domain",
        "type": "link",
        "to": {
          "screen": "hosting.site.edit",
          "params": {
            "id": "$id"
          }
        },
        "sortable": true,
        "primary": true
      },
      {
        "key": "state",
        "type": "status",
        "map": {
          "active": "success",
          "error": "danger",
          "pending": "neutral"
        },
        "filter": {
          "options": [
            "pending",
            "active",
            "error"
          ]
        }
      },
      {
        "key": "suspended",
        "type": "boolean"
      },
      {
        "key": "php",
        "type": "text"
      },
      {
        "key": "root",
        "type": "text"
      },
      {
        "key": "error",
        "type": "text"
      },
      {
        "key": "zoneError",
        "type": "text"
      }
    ],
    "actions": [
      {
        "id": "create",
        "role": "new",
        "screen": "hosting.site.create",
        "icon": "plus"
      },
      {
        "id": "edit",
        "role": "edit",
        "screen": "hosting.site.edit",
        "default": true
      },
      {
        "id": "open_zone",
        "role": "external",
        "function": "hosting.site.open_zone",
        "params": {
          "id": "$id"
        }
      },
      {
        "id": "delete",
        "role": "delete",
        "function": "hosting.site.delete",
        "confirm": {
          "destructive": true,
          "items": "domain",
          "input": "count"
        }
      }
    ],
    "row_actions": [
      "edit",
      "open_zone",
      "delete"
    ],
    "empty": {
      "title": "hosting.site.empty",
      "action": "create"
    },
    "invalidate_on": [
      "hosting.site.*"
    ]
  }
}
