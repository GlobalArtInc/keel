{
  "keel": 1,
  "name": "dns.record.list",
  "module": "dns_record",
  "kind": "list",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "dns.zone.read",
    "feature": "dns.zones"
  },
  "key": "id",
  "params": {
    "$ref": "keel://ListQuery"
  },
  "result": {
    "title": "Page_Record",
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Record"
        }
      },
      "total": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "totals": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "data",
      "total"
    ],
    "$defs": {
      "Record": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "zoneId": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "value": {
            "type": "string"
          },
          "ttl": {
            "type": "integer",
            "format": "int32"
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "weight": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "port": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "zoneId",
          "accountId",
          "type",
          "name",
          "value",
          "ttl",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  },
  "ui": {
    "title": "dns.record.list.title",
    "search": [
      "name",
      "value"
    ],
    "columns": [
      {
        "key": "name",
        "type": "link",
        "to": {
          "screen": "dns.record.edit",
          "params": {
            "id": "$id"
          }
        },
        "sortable": true,
        "primary": true
      },
      {
        "key": "type",
        "type": "text",
        "sortable": true,
        "filter": {
          "options": [
            "A",
            "AAAA",
            "CNAME",
            "MX",
            "TXT",
            "NS",
            "SRV",
            "CAA"
          ]
        }
      },
      {
        "key": "value",
        "type": "text"
      },
      {
        "key": "ttl",
        "type": "number",
        "sortable": true
      },
      {
        "key": "priority",
        "type": "number"
      },
      {
        "key": "updatedAt",
        "type": "datetime",
        "sortable": true
      }
    ],
    "actions": [
      {
        "id": "create",
        "role": "new",
        "screen": "dns.record.create",
        "icon": "plus",
        "params": {
          "zone": "$screen.params.zone_id"
        }
      },
      {
        "id": "edit",
        "role": "edit",
        "screen": "dns.record.edit",
        "default": true
      },
      {
        "id": "delete",
        "role": "delete",
        "function": "dns.record.delete",
        "confirm": {
          "destructive": true,
          "items": "name",
          "input": "count"
        }
      }
    ],
    "row_actions": [
      "edit",
      "delete"
    ],
    "empty": {
      "title": "dns.record.empty",
      "action": "create"
    },
    "invalidate_on": [
      "dns.record.*"
    ]
  }
}
