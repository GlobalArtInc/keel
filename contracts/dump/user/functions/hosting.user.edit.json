{
  "keel": 1,
  "name": "hosting.user.edit",
  "module": "hosting",
  "kind": "form",
  "mode": "write",
  "access": {
    "level": "user",
    "permission": "hosting.user.manage",
    "feature": "panel.users"
  },
  "key": "id",
  "params": {
    "title": "UserEdit",
    "type": "object",
    "properties": {
      "id": {
        "$ref": "#/$defs/Id"
      },
      "shell": {
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "shell"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "result": {
    "title": "HostingUser",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "accountId": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "uid": {
        "type": [
          "integer",
          "null"
        ],
        "format": "int64"
      },
      "home": {
        "type": [
          "string",
          "null"
        ]
      },
      "shell": {
        "type": "boolean"
      },
      "state": {
        "type": "string"
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "accountId",
      "name",
      "shell",
      "state",
      "createdAt",
      "updatedAt"
    ]
  },
  "ui": {
    "title": "hosting.user.edit.title",
    "read": "hosting.user.get",
    "pages": [
      {
        "id": "main",
        "fields": [
          "shell"
        ]
      }
    ]
  }
}
