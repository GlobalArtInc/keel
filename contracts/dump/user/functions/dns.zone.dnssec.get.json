      }
    },
    "required": [
      "id"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "result": {
    "title": "Dnssec",
    "type": "object",
    "properties": {
      "state": {
        "$ref": "#/$defs/Signing"
      }
    },
    "required": [
      "state"
    ],
    "$defs": {
      "Signing": {
        "type": "string",
        "enum": [
          "unsigned"
        ]
      }
    }
  },
  "ui": {
    "title": "dns.zone.dnssec.title"
  }
}
