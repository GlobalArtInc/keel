{
  "keel": 1,
  "name": "dns.zone.dnssec.get",
  "module": "dns",
  "kind": "get",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "dns.zone.read",
    "feature": "dns.dnssec"
  },
  "key": "id",
  "params": {
    "title": "Pick",
