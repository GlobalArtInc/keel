{
  "keel": 1,
  "name": "hosting.site.get",
  "module": "hosting_site",
  "kind": "get",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "hosting.site.read",
    "feature": "panel.web"
  },
  "key": "id",
  "params": {
    "title": "Pick",
    "type": "object",
    "properties": {
      "id": {
        "$ref": "#/$defs/Id"
      }
    },
    "required": [
      "id"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "result": {
    "title": "HostingSite",
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "accountId": {
        "type": "string"
      },
      "userId": {
        "type": "string"
      },
      "domain": {
        "type": "string"
      },
      "aliases": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "root": {
        "type": "string"
      },
      "php": {
        "type": [
          "string",
          "null"
        ]
      },
      "suspended": {
        "type": "boolean"
      },
      "state": {
        "type": "string"
      },
      "error": {
        "type": [
          "string",
          "null"
        ]
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "accountId",
      "userId",
      "domain",
      "aliases",
      "root",
      "suspended",
      "state",
      "createdAt",
      "updatedAt"
    ]
  }
}
