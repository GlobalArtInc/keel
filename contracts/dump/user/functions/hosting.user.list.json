{
  "keel": 1,
  "name": "hosting.user.list",
  "module": "hosting",
  "kind": "list",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "hosting.user.read",
    "feature": "panel.users"
  },
  "key": "id",
  "params": {
    "$ref": "keel://ListQuery"
  },
  "result": {
    "title": "Page_HostingUser",
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/HostingUser"
        }
      },
      "total": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "totals": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "data",
      "total"
    ],
    "$defs": {
      "HostingUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "accountId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "uid": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "home": {
            "type": [
              "string",
              "null"
            ]
          },
          "shell": {
            "type": "boolean"
          },
          "state": {
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "accountId",
          "name",
          "shell",
          "state",
          "createdAt",
          "updatedAt"
        ]
      }
    }
  },
  "ui": {
    "title": "hosting.user.list.title",
    "search": [
      "name"
    ],
    "columns": [
      {
        "key": "name",
        "type": "link",
        "to": {
          "screen": "hosting.user.edit",
          "params": {
            "id": "$id"
          }
        },
        "sortable": true,
        "primary": true
      },
      {
        "key": "state",
        "type": "status",
        "map": {
          "active": "success",
          "error": "danger",
          "pending": "neutral",
          "suspended": "warning"
        },
        "filter": {
          "options": [
            "pending",
            "active",
            "suspended",
            "error"
          ]
        }
      },
      {
        "key": "uid",
        "type": "number"
      },
      {
        "key": "home",
        "type": "text"
      },
      {
        "key": "shell",
        "type": "boolean"
      },
      {
        "key": "error",
        "type": "text"
      }
    ],
    "actions": [
      {
        "id": "create",
        "role": "new",
        "screen": "hosting.user.create",
        "icon": "plus"
      },
      {
        "id": "edit",
        "role": "edit",
        "screen": "hosting.user.edit",
        "default": true
      },
      {
        "id": "delete",
        "role": "delete",
        "function": "hosting.user.delete",
        "confirm": {
          "destructive": true,
          "items": "name",
          "input": "count"
        }
      }
    ],
    "row_actions": [
      "edit",
      "delete"
    ],
    "empty": {
      "title": "hosting.user.empty",
      "action": "create"
    },
    "invalidate_on": [
      "hosting.user.*"
    ]
  }
}
