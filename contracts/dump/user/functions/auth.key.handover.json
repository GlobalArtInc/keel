{
  "keel": 1,
  "name": "auth.key.handover",
  "module": "auth",
  "kind": "action",
  "mode": "write",
  "access": {
    "level": "user"
  },
  "params": {
    "title": "Handover",
    "type": "object",
    "properties": {
      "ttl": {
        "type": "integer",
        "format": "uint32",
        "minimum": 1,
        "maximum": 300
      },
      "redirect": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "required": [
      "ttl",
      "redirect"
    ]
  },
  "result": {
    "title": "Issued",
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "x-keel": {
          "once": true
        }
      },
      "url": {
        "type": "string",
        "x-keel": {
          "once": true
        }
      }
    },
    "required": [
      "key",
      "url"
    ]
  }
}
