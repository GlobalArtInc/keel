{
  "keel": 1,
  "name": "auth.password.set",
  "module": "auth",
  "kind": "form",
  "mode": "write",
  "access": {
    "level": "user",
    "permission": "auth.password.manage"
  },
  "params": {
    "title": "PasswordSet",
    "type": "object",
    "properties": {
      "password": {
        "$ref": "#/$defs/Secret",
        "x-keel": {
          "secret": true
        },
        "x-ui": {
          "control": "password"
        }
      },
      "current": {
        "anyOf": [
          {
            "$ref": "#/$defs/Secret"
          },
          {
            "type": "null"
          }
        ],
        "x-keel": {
          "secret": true
        },
        "x-ui": {
          "control": "password"
        }
      }
    },
    "required": [
      "password"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      },
      "Secret": {
        "type": "string",
        "writeOnly": true
      }
    }
  },
  "result": {
    "title": "PasswordChanged",
    "type": "object",
    "properties": {
      "principal": {
        "$ref": "#/$defs/Id"
      }
    },
    "required": [
      "principal"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "ui": {
    "title": "auth.password.set.title",
    "pages": [
      {
        "id": "main",
        "fields": [
          "current",
          "password"
        ]
      }
    ]
  }
}
