{
  "keel": 1,
  "name": "keel.account.create",
  "module": "keel",
  "kind": "form",
  "mode": "write",
  "access": {
    "level": "reseller",
    "permission": "keel.account.manage"
  },
  "params": {
    "title": "AccountCreate",
    "type": "object",
    "properties": {
      "kind": {
        "type": "string",
        "x-keel": {
          "check": "name"
        }
      },
      "parent": {
        "anyOf": [
          {
            "$ref": "#/$defs/Id"
          },
          {
            "type": "null"
          }
        ],
        "x-keel": {
          "level": "reseller",
          "options": "keel.account.options"
        }
      }
    },
    "required": [
      "kind"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "result": {
    "title": "Saved",
    "type": "object",
    "properties": {
      "id": {
        "$ref": "#/$defs/Id"
      }
    },
    "required": [
      "id"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "ui": {
    "title": "keel.account.create.title",
    "pages": [
      {
        "id": "main",
        "fields": [
          "kind",
          "parent"
        ]
      }
    ]
  }
}
