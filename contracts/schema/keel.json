{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "keel.json",
  "$defs": {
    "Access": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/$defs/Level"
        },
        "permission": {
          "type": [
            "string",
            "null"
          ]
        },
        "feature": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "level"
      ]
    },
    "Account": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "kind": {
          "type": "string"
        },
        "parentId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        },
        "path": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AccountState"
        },
        "externalId": {
          "type": [
            "string",
            "null"
          ]
        },
        "origin": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "path",
        "state"
      ]
    },
    "AccountState": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "deleting"
      ]
    },
    "Action": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/ActionRole"
        },
        "screen": {
          "type": [
            "string",
            "null"
          ]
        },
        "function": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "default": {
          "type": "boolean"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "confirm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Confirm"
            },
            {
              "type": "null"
            }
          ]
        },
        "hidden_if": {
          "anyOf": [
            {
              "$ref": "#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ]
        },
        "formats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExportFormat"
          }
        },
        "disabled": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "role"
      ]
    },
    "ActionRole": {
      "type": "string",
      "enum": [
        "new",
        "edit",
        "delete",
        "group",
        "button",
        "child",
        "external",
        "export",
        "upload",
        "download",
        "refresh"
      ]
    },
    "ActorVia": {
      "type": "string",
      "enum": [
        "su",
        "socket",
        "peer"
      ]
    },
    "Badge": {
      "type": "object",
      "properties": {
        "problem": {
          "type": "string"
        }
      },
      "required": [
        "problem"
      ]
    },
    "Band": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Column"
          }
        },
        "formats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExportFormat"
          }
        }
      },
      "required": [
        "id",
        "columns"
      ]
    },
    "Boot": {
      "type": "object",
      "properties": {
        "keel": {
          "$ref": "#/$defs/Platform"
        },
        "products": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BootProduct"
          }
        },
        "brand": {
          "$ref": "#/$defs/BootBrand"
        },
        "principal": {
          "anyOf": [
            {
              "$ref": "#/$defs/BootPrincipal"
            },
            {
              "type": "null"
            }
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license": {
          "anyOf": [
            {
              "$ref": "#/$defs/BootLicense"
            },
            {
              "type": "null"
            }
          ]
        },
        "menu": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BootMenuGroup"
          }
        },
        "dashboard": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BootWidget"
          }
        },
        "views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "meta": {
          "type": "string"
        },
        "problems": {
          "anyOf": [
            {
              "$ref": "#/$defs/BootProblems"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "keel",
        "products",
        "brand",
        "features",
        "menu",
        "dashboard",
        "views",
        "meta"
      ]
    },
    "BootBrand": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "logo": {
          "type": [
            "string",
            "null"
          ]
        },
        "hue": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "chroma": {
          "type": "number",
          "format": "double"
        }
      },
      "required": [
        "name",
        "hue",
        "chroma"
      ]
    },
    "BootLicense": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/LicenseState"
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "graceEndsAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "state"
      ]
    },
    "BootMenuGroup": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "product": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BootMenuItem"
          }
        }
      },
      "required": [
        "id",
        "label",
        "icon",
        "items"
      ]
    },
    "BootMenuItem": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "func": {
          "type": "string"
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/Kind"
            },
            {
              "type": "null"
            }
          ]
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "badge": {
          "anyOf": [
            {
              "$ref": "#/$defs/Badge"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "path",
        "label",
        "func"
      ]
    },
    "BootPrincipal": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "login": {
          "type": "string"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "account": {
          "$ref": "#/$defs/Id"
        },
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/MetaActor"
            },
            {
              "type": "null"
            }
          ]
        },
        "lang": {
          "type": "string"
        },
        "tz": {
          "type": [
            "string",
            "null"
          ]
        },
        "totp": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "login",
        "level",
        "account",
        "lang",
        "totp"
      ]
    },
    "BootProblems": {
      "type": "object",
      "properties": {
        "open": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "critical": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "open",
        "critical"
      ]
    },
    "BootProduct": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "edition": {
          "type": [
            "string",
            "null"
          ]
        },
        "brand": {
          "$ref": "#/$defs/BootBrand"
        }
      },
      "required": [
        "id",
        "name",
        "brand"
      ]
    },
    "BootWidget": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/WidgetKind"
        },
        "func": {
          "type": "string"
        },
        "limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "func"
      ]
    },
    "CallError": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "key": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        },
        "requestId": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FieldError"
          }
        }
      },
      "required": [
        "code",
        "key"
      ]
    },
    "Chart": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ChartType"
        },
        "series": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "id",
        "type",
        "series"
      ]
    },
    "ChartType": {
      "type": "string",
      "enum": [
        "line",
        "bar",
        "pie"
      ]
    },
    "Check": {
      "type": "string",
      "enum": [
        "domain",
        "ip",
        "ipv4",
        "ipv6",
        "cidr",
        "email",
        "int",
        "name",
        "port",
        "path",
        "quoted",
        "caa"
      ]
    },
    "CheckBy": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string"
        },
        "cases": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Check"
          }
        }
      },
      "required": [
        "field",
        "cases"
      ]
    },
    "Choice": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        },
        "icon": {
          "type": [
            "string",
            "null"
          ]
        },
        "group": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "value",
        "label"
      ]
    },
    "Choices": {
      "type": "object",
      "properties": {
        "data": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Choice"
          }
        },
        "more": {
          "type": "boolean"
        }
      },
      "required": [
        "data",
        "more"
      ]
    },
    "Column": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ColumnType"
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/Link"
            },
            {
              "type": "null"
            }
          ]
        },
        "sortable": {
          "type": "boolean"
        },
        "primary": {
          "type": "boolean"
        },
        "total": {
          "anyOf": [
            {
              "$ref": "#/$defs/Total"
            },
            {
              "type": "null"
            }
          ]
        },
        "map": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/Tone"
          }
        },
        "filter": {
          "anyOf": [
            {
              "$ref": "#/$defs/ColumnFilter"
            },
            {
              "type": "null"
            }
          ]
        },
        "edit": {
          "anyOf": [
            {
              "$ref": "#/$defs/InlineEdit"
            },
            {
              "type": "null"
            }
          ]
        },
        "access": {
          "anyOf": [
            {
              "$ref": "#/$defs/MemberAccess"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "key",
        "type"
      ]
    },
    "ColumnFilter": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "options": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "options"
          ]
        },
        {
          "type": "object",
          "properties": {
            "remote": {
              "type": "string"
            }
          },
          "required": [
            "remote"
          ]
        }
      ]
    },
    "ColumnType": {
      "type": "string",
      "enum": [
        "text",
        "number",
        "link",
        "status",
        "toggle",
        "date",
        "datetime",
        "boolean"
      ]
    },
    "Confirm": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/ConfirmDetails"
        }
      ]
    },
    "ConfirmDetails": {
      "type": "object",
      "properties": {
        "destructive": {
          "type": "boolean"
        },
        "items": {
          "type": [
            "string",
            "null"
          ]
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/$defs/ConfirmInput"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ConfirmInput": {
      "type": "string",
      "enum": [
        "count"
      ]
    },
    "Context": {
      "type": "object",
      "properties": {
        "fields": {
          "type": "object",
          "additionalProperties": true
        },
        "mode": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContextPrincipal"
            },
            {
              "type": "null"
            }
          ]
        },
        "screen": {
          "anyOf": [
            {
              "$ref": "#/$defs/ContextScreen"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ContextPrincipal": {
      "type": "object",
      "properties": {
        "level": {
          "$ref": "#/$defs/Level"
        }
      },
      "required": [
        "level"
      ]
    },
    "ContextScreen": {
      "type": "object",
      "properties": {
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "Control": {
      "type": "string",
      "enum": [
        "input",
        "password",
        "select",
        "toggle",
        "switcher",
        "slider",
        "date",
        "time",
        "file",
        "list",
        "code",
        "tags",
        "key_value",
        "transfer"
      ]
    },
    "DashboardLayout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "hidden": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "Descriptor": {
      "type": "object",
      "properties": {
        "keel": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "name": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/Kind"
        },
        "mode": {
          "$ref": "#/$defs/Mode"
        },
        "access": {
          "$ref": "#/$defs/Access"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "params": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "result": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "ui": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScreenUi"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "keel",
        "name",
        "module",
        "kind",
        "mode",
        "access",
        "params",
        "result"
      ]
    },
    "DownloadFile": {
      "type": "object",
      "properties": {
        "filename": {
          "type": "string"
        },
        "contentType": {
          "type": "string"
        }
      },
      "required": [
        "filename",
        "contentType"
      ]
    },
    "DownloadLink": {
      "type": "object",
      "properties": {
        "function": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "function",
        "params"
      ]
    },
    "DownloadRef": {
      "type": "object",
      "properties": {
        "download": {
          "$ref": "#/$defs/DownloadLink"
        }
      },
      "required": [
        "download"
      ]
    },
    "Empty": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "action": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "title"
      ]
    },
    "Envelope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": true
            },
            "data": true,
            "meta": {
              "$ref": "#/$defs/Meta"
            }
          },
          "required": [
            "ok",
            "data",
            "meta"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ok": {
              "const": false
            },
            "error": {
              "$ref": "#/$defs/CallError"
            }
          },
          "required": [
            "ok",
            "error"
          ]
        }
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "validation",
        "forbidden",
        "forbidden_field",
        "unauthenticated",
        "not_found",
        "conflict",
        "idempotency_mismatch",
        "limit_exceeded",
        "license",
        "rate_limited",
        "unavailable",
        "peer",
        "internal"
      ]
    },
    "Event": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "type": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "instanceId": {
          "$ref": "#/$defs/Id"
        },
        "module": {
          "type": "string"
        },
        "actor": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventActor"
            },
            {
              "type": "null"
            }
          ]
        },
        "subject": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventSubject"
            },
            {
              "type": "null"
            }
          ]
        },
        "data": {
          "default": null
        }
      },
      "required": [
        "id",
        "seq",
        "type",
        "at",
        "instanceId",
        "module"
      ]
    },
    "EventActor": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/EventActorKind"
        },
        "id": {
          "$ref": "#/$defs/Id"
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "EventActorKind": {
      "type": "string",
      "enum": [
        "principal",
        "peer",
        "system"
      ]
    },
    "EventSubject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string"
        },
        "id": {
          "$ref": "#/$defs/Id"
        },
        "accountId": {
          "anyOf": [
            {
              "$ref": "#/$defs/Id"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "id"
      ]
    },
    "ExportFormat": {
      "type": "string",
      "enum": [
        "csv",
        "json"
      ]
    },
    "Expr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "eq": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "string"
                },
                true
              ],
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "eq"
