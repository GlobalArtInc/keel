[Unit]
Description=keel host spike agent
Documentation=https://github.com/GlobalArtInc/keel

[Service]
Type=simple
ExecStart=/usr/local/bin/keel-spike agent --socket /run/keel-spike/agent.sock --uid @UID@ --policy /etc/keel-spike/spike.yaml --templates /etc/keel-spike/templates
RuntimeDirectory=keel-spike
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
