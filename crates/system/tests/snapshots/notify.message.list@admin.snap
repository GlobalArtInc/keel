---
source: crates/testkit/src/snapshots.rs
info:
  function: notify.message.list
  level: admin
---
{
  "keel": 1,
  "name": "notify.message.list",
  "module": "notify",
  "kind": "list",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "notify.read"
  },
  "key": "id",
  "params": {
    "$ref": "keel://ListQuery"
  },
  "result": {
    "title": "Page_Note",
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Note"
        }
      },
      "total": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "totals": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "data",
      "total"
    ],
    "$defs": {
      "Note": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/Id"
          },
          "key": {
            "type": "string"
          },
          "params": true,
          "level": {
            "$ref": "#/$defs/NotificationLevel"
          },
          "source": {
            "type": "string"
          },
          "problem": {
            "anyOf": [
              {
                "$ref": "#/$defs/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "unread": {
            "type": "boolean"
          },
          "readAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "key",
          "params",
          "level",
          "source",
          "unread",
          "createdAt"
        ]
      },
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      },
      "NotificationLevel": {
        "type": "string",
        "enum": [
          "info",
          "warning",
          "error"
        ]
      }
    }
  },
  "ui": {
    "title": "notify.message.list.title",
    "search": [
      "key"
    ],
    "columns": [
      {
        "key": "key",
        "type": "text",
        "sortable": true,
        "primary": true
      },
      {
        "key": "level",
        "type": "status",
        "map": {
          "error": "danger",
          "info": "info",
          "warning": "warning"
        },
        "filter": {
          "options": [
            "info",
            "warning",
            "error"
          ]
        }
      },
      {
        "key": "source",
        "type": "text"
      },
      {
        "key": "unread",
        "type": "boolean",
        "sortable": true,
        "filter": {
          "options": [
            "true",
            "false"
          ]
        }
      },
      {
        "key": "createdAt",
        "type": "datetime",
        "sortable": true
      },
      {
        "key": "readAt",
        "type": "datetime",
        "sortable": true
      }
    ],
    "actions": [
      {
        "id": "mark_read",
        "role": "group",
        "function": "notify.message.mark",
        "icon": "check"
      },
      {
        "id": "clear",
        "role": "button",
        "function": "notify.message.clear",
        "icon": "trash-2",
        "confirm": true
      }
    ],
    "row_actions": [
      "mark_read"
    ],
    "empty": {
      "title": "notify.message.empty"
    },
    "invalidate_on": [
      "notify.message.*"
    ]
  }
}
