{
  "keel": 1,
  "name": "auth.session.list",
  "module": "auth",
  "kind": "list",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "auth.session.read"
  },
  "key": "id",
  "params": {
    "$ref": "keel://ListQuery"
  },
  "result": {
    "title": "Page_SessionRow",
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/SessionRow"
        }
      },
      "total": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "totals": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "data",
      "total"
    ],
    "$defs": {
      "SessionRow": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "ip": {
            "type": [
              "string",
              "null"
            ]
          },
          "userAgent": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "idleUntil": {
            "type": "string",
            "format": "date-time"
          },
          "absoluteUntil": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "anyOf": [
              {
                "$ref": "#/$defs/Id"
              },
              {
                "type": "null"
              }
            ]
          },
          "current": {
            "type": "boolean"
          },
          "revokedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "createdAt",
          "idleUntil",
          "absoluteUntil",
          "current"
        ]
      },
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "ui": {
    "title": "auth.session.list.title",
    "search": [
      "ip",
      "userAgent"
    ],
    "columns": [
      {
        "key": "kind",
        "type": "text",
        "sortable": true,
        "filter": {
          "options": [
            "session",
            "su"
          ]
        }
      },
      {
        "key": "ip",
        "type": "text",
        "sortable": true,
        "primary": true
      },
      {
        "key": "userAgent",
        "type": "text"
      },
      {
        "key": "createdAt",
        "type": "datetime",
        "sortable": true
      },
      {
        "key": "idleUntil",
        "type": "datetime",
        "sortable": true
      },
      {
        "key": "absoluteUntil",
        "type": "datetime",
        "sortable": true
      },
      {
        "key": "actor",
        "type": "text"
      },
      {
        "key": "current",
        "type": "boolean"
      },
      {
        "key": "revokedAt",
        "type": "datetime",
        "sortable": true
      }
    ],
    "actions": [
      {
        "id": "revoke",
        "role": "button",
        "function": "auth.session.revoke",
        "params": {
          "id": "$id"
        },
        "confirm": true
      }
    ],
    "row_actions": [
      "revoke"
    ],
    "empty": {
      "title": "auth.session.empty"
    },
    "invalidate_on": [
      "auth.session.*",
      "auth.logout",
      "auth.su.*"
    ]
  }
}
