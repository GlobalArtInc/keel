---
source: crates/testkit/src/snapshots.rs
info:
  function: auth.key.issue
  level: reseller
---
{
  "keel": 1,
  "name": "auth.key.issue",
  "module": "auth",
  "kind": "form",
  "mode": "write",
  "access": {
    "level": "reseller",
    "permission": "auth.key.issue"
  },
  "params": {
    "title": "Issue",
    "type": "object",
    "properties": {
      "principal": {
        "$ref": "#/$defs/Id"
      },
      "ttl": {
        "type": "integer",
        "format": "uint32",
        "minimum": 1,
        "maximum": 300
      },
      "redirect": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    },
    "required": [
      "principal",
      "ttl",
      "redirect"
    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "result": {
    "title": "Issued",
    "type": "object",
    "properties": {
      "key": {
        "type": "string",
        "x-keel": {
          "once": true
        }
      },
      "url": {
        "type": "string",
        "x-keel": {
          "once": true
        }
      }
    },
    "required": [
      "key",
      "url"
    ]
  },
  "ui": {
    "title": "auth.key.issue.title",
    "pages": [
      {
        "id": "main",
        "fields": [
          "principal",
          "ttl",
          "redirect"
        ]
      }
    ]
  }
}
