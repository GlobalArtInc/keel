{
  "keel": 1,
  "name": "auth.key.redeem",
  "module": "auth",
  "kind": "form",
  "mode": "write",
  "access": {
    "level": "guest"
  },
  "params": {
    "title": "Redeem",
    "type": "object",
    "properties": {
      "key": {
        "$ref": "#/$defs/Secret",
        "x-keel": {
          "secret": true
        }
      }
    },
    "required": [
      "key"
    ],
    "$defs": {
      "Secret": {
        "type": "string",
        "writeOnly": true
      }
    }
  },
  "result": {
    "title": "Redeemed",
    "type": "object",
    "properties": {
      "redirect": {
        "type": "string"
      },
      "principal": {
        "$ref": "#/$defs/MetaPrincipal"
      },
      "issuedBy": {
        "$ref": "#/$defs/Id"
      }
    },
    "required": [
      "redirect",
      "principal",
      "issuedBy"
    ],
    "$defs": {
      "MetaPrincipal": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/Id"
          },
          "login": {
            "type": "string"
          },
          "level": {
            "$ref": "#/$defs/Level"
          },
          "account": {
            "$ref": "#/$defs/Id"
          },
          "actor": {
            "anyOf": [
              {
                "$ref": "#/$defs/MetaActor"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "login",
          "level",
          "account"
        ]
      },
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      },
      "Level": {
        "type": "string",
        "enum": [
          "guest",
          "service",
          "user",
          "reseller",
          "admin",
          "owner"
        ]
      },
      "MetaActor": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/Id"
          },
          "login": {
            "type": "string"
          },
          "level": {
            "$ref": "#/$defs/Level"
          },
          "via": {
            "$ref": "#/$defs/ActorVia"
          }
        },
        "required": [
          "id",
          "login",
          "level",
          "via"
        ]
      },
      "ActorVia": {
        "type": "string",
        "enum": [
          "su",
          "socket",
          "peer"
        ]
      }
    }
  },
  "ui": {
    "title": "auth.key.redeem.title",
    "pages": [
