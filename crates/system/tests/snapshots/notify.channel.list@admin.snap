info:
  function: notify.channel.list
  level: admin
---
{
  "keel": 1,
  "name": "notify.channel.list",
  "module": "notify",
  "kind": "list",
  "mode": "read",
  "access": {
    "level": "admin"
  },
  "key": "id",
  "params": {
    "$ref": "keel://ListQuery"
  },
  "result": {
    "title": "Page_Channel",
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Channel"
        }
      },
      "total": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "totals": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "data",
      "total"
    ],
    "$defs": {
      "Channel": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/Id"
          },
          "kind": {
            "$ref": "#/$defs/ChannelKind"
          },
          "name": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "email": {
            "anyOf": [
              {
                "$ref": "#/$defs/EmailView"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastSentAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdBy": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "name",
          "enabled",
          "createdAt",
          "createdBy"
        ]
      },
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      },
      "ChannelKind": {
        "type": "string",
        "enum": [
          "email",
          "telegram",
          "webhook"
        ]
      },
      "EmailView": {
        "type": "object",
        "properties": {
          "host": {
            "type": "string"
          },
          "port": {
            "type": "integer",
            "format": "uint16",
            "minimum": 0,
            "maximum": 65535
          },
          "security": {
            "$ref": "#/$defs/Security"
          },
          "username": {
            "type": [
              "string",
              "null"
            ]
          },
          "hasPassword": {
            "type": "boolean"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "host",
          "port",
          "security",
          "hasPassword",
          "from",
          "to"
        ]
      },
      "Security": {
        "type": "string",
        "enum": [
          "none",
          "starttls",
          "tls"
        ]
      }
    }
  },
  "ui": {
    "title": "notify.channel.list.title",
    "search": [
      "name"
    ],
    "columns": [
      {
        "key": "name",
        "type": "link",
        "to": {
          "screen": "notify.channel.set",
          "params": {
            "id": "$id"
          }
        },
        "sortable": true,
        "primary": true
      },
      {
        "key": "kind",
        "type": "status",
        "map": {
          "email": "info",
          "telegram": "neutral",
          "webhook": "neutral"
        },
        "filter": {
          "options": [
            "email",
            "telegram",
            "webhook"
          ]
        }
      },
      {
        "key": "enabled",
        "type": "boolean",
        "sortable": true
      },
      {
        "key": "lastSentAt",
        "type": "datetime",
        "sortable": true
      },
      {
        "key": "lastError",
        "type": "text"
      },
      {
        "key": "createdAt",
        "type": "datetime",
        "sortable": true
      }
    ],
    "actions": [
      {
        "id": "create",
        "role": "new",
        "screen": "notify.channel.set",
        "icon": "plus"
      },
      {
        "id": "edit",
        "role": "edit",
        "screen": "notify.channel.set",
        "default": true
      },
      {
        "id": "test",
        "role": "button",
        "function": "notify.channel.test",
        "icon": "send",
        "params": {
          "id": "$id"
        }
      },
      {
        "id": "delete",
        "role": "delete",
        "function": "notify.channel.delete",
        "confirm": {
          "destructive": true,
          "items": "name"
        }
      }
    ],
    "row_actions": [
      "edit",
      "test",
      "delete"
    ],
    "empty": {
      "title": "notify.channel.empty",
      "action": "create"
    },
    "invalidate_on": [
      "notify.channel.*"
    ]
  }
}
