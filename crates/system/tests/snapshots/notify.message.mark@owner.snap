{
  "keel": 1,
  "name": "notify.message.mark",
  "module": "notify",
  "kind": "action",
  "mode": "write",
  "access": {
    "level": "user",
    "permission": "notify.manage"
  },
  "key": "ids",
  "params": {
    "title": "Mark",
    "type": "object",
    "properties": {
      "ids": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Id"
        },
        "minItems": 1
