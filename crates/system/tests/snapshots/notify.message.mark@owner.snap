    ],
    "$defs": {
      "Id": {
        "type": "string",
        "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
        "minLength": 26,
        "maxLength": 26
      }
    }
  },
  "result": {
    "title": "Marked",
    "type": "object",
    "properties": {
      "marked": {
        "type": "integer",
        "format": "uint64",
