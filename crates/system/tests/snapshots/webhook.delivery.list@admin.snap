---
source: crates/testkit/src/snapshots.rs
info:
  function: webhook.delivery.list
  level: admin
---
{
  "keel": 1,
  "name": "webhook.delivery.list",
  "module": "webhook",
  "kind": "list",
  "mode": "read",
  "access": {
    "level": "user",
    "permission": "webhook.manage"
  },
  "key": "id",
  "params": {
    "$ref": "keel://ListQuery"
  },
  "result": {
    "title": "Page_Delivery",
    "type": "object",
    "properties": {
      "data": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Delivery"
        }
      },
      "total": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "totals": {
        "type": [
          "object",
          "null"
        ],
        "additionalProperties": true
      }
    },
    "required": [
      "data",
      "total"
    ],
    "$defs": {
      "Delivery": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "subscriptionId": {
            "type": "string"
          },
          "eventId": {
            "type": "string"
          },
          "seq": {
            "type": "integer",
            "format": "int64"
          },
          "type": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "attempt": {
            "type": "integer",
            "format": "int32"
          },
          "nextAt": {
            "type": "string",
            "format": "date-time"
          },
          "lastStatus": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "lastError": {
            "type": [
              "string",
              "null"
            ]
          },
          "deliveredAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "accountId": {
            "type": "string",
            "x-keel": {
              "level": "reseller"
            }
          }
        },
        "required": [
          "id",
          "subscriptionId",
          "eventId",
          "seq",
          "type",
          "state",
          "attempt",
          "nextAt",
          "createdAt",
          "accountId"
        ]
      }
    }
  },
  "ui": {
    "title": "webhook.delivery.list.title",
    "search": [
      "eventId",
      "type"
    ],
    "columns": [
      {
        "key": "eventId",
        "type": "link",
        "to": {
          "screen": "webhook.delivery.get",
          "params": {
            "id": "$id"
          }
        },
        "primary": true
      },
      {
        "key": "type",
        "type": "text",
        "sortable": true
      },
      {
        "key": "state",
        "type": "status",
        "sortable": true,
        "map": {
          "dead": "danger",
          "delivered": "success",
          "failed": "warning",
          "pending": "neutral"
        },
        "filter": {
          "options": [
            "pending",
            "delivered",
            "failed",
            "dead"
          ]
        }
      },
      {
        "key": "attempt",
        "type": "number",
        "sortable": true
      },
      {
        "key": "nextAt",
        "type": "datetime",
        "sortable": true
      },
      {
        "key": "lastStatus",
        "type": "number"
      },
      {
        "key": "lastError",
        "type": "text"
      },
      {
        "key": "createdAt",
        "type": "datetime",
        "sortable": true
      }
    ],
    "actions": [
      {
        "id": "retry",
        "role": "button",
        "function": "webhook.delivery.retry",
        "icon": "rotate-cw",
        "params": {
          "id": "$id"
        },
        "hidden_if": {
          "in": [
            "state",
            [
              "pending",
              "delivered"
            ]
          ]
        }
      }
    ],
    "row_actions": [
      "retry"
    ],
    "empty": {
      "title": "webhook.delivery.empty"
    },
    "invalidate_on": [
      "webhook.delivery.*"
    ]
  }
}
